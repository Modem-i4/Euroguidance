{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "parts-blocks/bullet-meta-list",
  "title": "Маркований список розробника (meta)",
  "category": "text",
  "icon": "editor-ul",
  "description": "Список маркерів, що зберігається у post meta як масив рядків.",
  "keywords": ["list", "ul", "meta"],
  "usesContext": ["postId", "postType"],
  "attributes": {
    "metaKey": { "type": "string", "default": "qual" },
    "showOnFront": { "type": "boolean", "default": true }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "className": true,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
